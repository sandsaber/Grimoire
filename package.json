{
  "name": "grimoire",
  "version": "1.3.1",
  "description": "Local-first AI agents for Obsidian: Claude Code, Codex, Qwen Code, Antigravity CLI, Gemini CLI, and OpenCode in a vault-native side panel.",
  "main": "main.js",
  "scripts": {
    "prebuild": "npm run lint",
    "build:css": "node scripts/build-css.mjs",
    "dev": "npm run build:css && node esbuild.config.mjs",
    "build": "node scripts/build.mjs production",
    "prebuild:release": "npm run lint && npm run review:source && npm run review:css && npm run review:deps",
    "build:release": "node scripts/build-release.mjs",
    "review:source": "node scripts/check-review-source.mjs",
    "review:css": "node scripts/check-review-css.mjs",
    "review:deps": "node scripts/check-review-dependencies.mjs",
    "check:release-metadata": "node scripts/check-release-metadata.mjs",
    "check:lockfile-age": "node scripts/check-lockfile-age.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "test": "node scripts/run-jest.js",
    "test:watch": "node scripts/run-jest.js --watch",
    "test:coverage": "node scripts/run-jest.js --coverage",
    "version": "node scripts/sync-version.js && git add manifest.json versions.json CHANGELOG.md package-lock.json"
  },
  "keywords": [
    "agentic-cli",
    "claude-code",
    "codex",
    "qwen-code",
    "antigravity-cli",
    "gemini-cli",
    "opencode",
    "mcp",
    "obsidian",
    "obsidian-plugin",
    "productivity",
    "ide"
  ],
  "author": "Michael Makarov",
  "license": "MIT",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=12.0.2 <13"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": false,
    "unrs-resolver@1.12.2": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.0",
    "eslint-plugin-jest": "^29.16.1",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "obsidian": "^1.13.1",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.241",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "smol-toml": "^1.8.0",
    "tslib": "^2.8.1",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "@hono/node-server": "^2.1.0"
  }
}
