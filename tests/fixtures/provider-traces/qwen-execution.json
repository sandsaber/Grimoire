      "tool-activity:agent-call-1",
      "parent-result:projection"
    ],
    "filesystemContainment": [
      "write:contained:approved",
      "read:contained",
      "escape:rejected-before-approval"
    ],
    "visibleHistoryHydration": [
      "history/visible:no-op"
    ]
  },
  "eventCases": {
    "success": [
      "run-started",
      "result:projection",
      "terminal:succeeded:completed"
    ],
    "recoveryAfterOutput": [
      "run-started",
      "connection-lost",
      "recovery-started",
      "result:provider-native",
      "terminal:succeeded:completed"
    ],
    "opaqueAgentEvidence": [
      "run-started",
      "tool-activity:agent-call-1",
      "result:projection",
      "terminal:succeeded:completed"
