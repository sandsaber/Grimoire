{
  "schemaVersion": 1,
  "providerId": "qwen",
  "backendId": "provider-qwen",
  "topology": "managed-acp-subprocess",
  "sessionBoundary": "acp-session",
  "resume": "native",
  "concurrency": "serial-runs",
  "runIdentity": "prompt-request-id",
  "resultExpectation": "required",
  "agentObservation": "none",
  "identity": {
    "backendGeneration": 1,
    "executionSessionId": "es-qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq",
    "sessionInstanceId": "si-qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq",
    "runId": "run-qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq",
    "nativeSessionId": "native-session",
    "nativeRunId": "prompt-1"
  },
  "cases": {
    "initializeNewPrompt": [
      "client/launch",
      "initialize",
      "session/new:native-session",
      "session/prompt:message-1",
      "result:projection"
    ],
    "resumeLoad": [
      "initialize",
      "session/load:saved-session",
      "session/prompt:message-1"
    ],
    "missingSessionReplacement": [
      "session/load:deleted-session",
      "session/new:native-session"
    ],
    "transientLoadFailure": [
      "session/load:saved-session",
      "terminal:invalidated:pre-dispatch-rejected"
    ],
    "retryBeforeOutput": [
      "client/launch",
      "session/prompt:message-1",
      "client/close",
      "client/launch",
      "session/load:native-session",
      "session/prompt:message-1"
    ],
    "restartConfiguration": [
      "client/close",
      "client/launch",
      "session/load:native-session",
      "session/prompt:message-2"
    ],
    "dynamicConfiguration": [
      "set-model:qwen3-coder-plus",
      "set-mode:plan",
      "prompt:/effort high"
    ],
    "approval": [
      "interaction-opened:approval",
      "interaction-resolved:allow-once"
    ],
    "filesystemContainment": [
      "write:contained:approved",
      "read:contained",
      "escape:rejected-before-approval"
    ],
    "isolatedAuxiliary": [
      "client/launch:retained",
      "session/new:aux-session",
      "session/prompt",
      "session/prompt:retained"
    ]
  },
  "eventCases": {
    "success": [
      "provider-content:session-config",
      "run-started",
      "provider-content:agent_message_chunk",
      "output-delta",
      "provider-content:prompt-result",
      "result:projection",
      "terminal:succeeded:completed"
    ],
    "recoveryAfterOutput": [
      "provider-content:session-config",
      "run-started",
      "provider-content:agent_message_chunk",
      "output-delta",
      "connection-lost",
      "recovery-started",
      "result:provider-native",
      "terminal:succeeded:completed"
    ]
  },
  "agentEvidence": {
    "definitions": "provider-files",
    "spawnOrigin": [],
    "stableIdentity": false,
    "progressObservation": "none",
    "resultExtraction": false,
    "cancellation": false,
    "statusQuery": false,
    "reattachment": false,
    "source": "none",
    "eventCase": null,
    "cancellationCase": null
  }
}
