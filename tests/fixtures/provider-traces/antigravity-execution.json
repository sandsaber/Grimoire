{
  "schemaVersion": 1,
  "providerId": "antigravity",
  "backendId": "provider-antigravity",
  "topology": "per-run-process",
  "concurrency": "serial-runs",
  "sessionIdentity": "grimoire-only",
  "resultExpectation": "required",
  "agentObservation": "none",
  "cases": {
    "stdoutSuccess": [
      "run-started",
      "result:projection",
      "terminal:succeeded:completed"
    ],
    "transcriptRecovery": [
      "run-started",
      "result:projection",
      "terminal:succeeded:completed"
    ],
    "emptyRequiredResult": [
      "run-started",
      "terminal:failed:missing-required-result"
    ],
    "nonzeroExit": [
      "run-started",
      "terminal:failed:nonzero-exit"
    ],
    "safeModePreDispatch": [
      "terminal:invalidated:pre-dispatch-rejected"
    ]
  }
}
